# Frontend-safe values. Only variables with VITE_ prefix may be read by browser code.
VITE_API_BASE_URL=http://localhost:8000

# Server-only runtime
APP_ENV=development
DEV_AUTH_ENABLED=true
TELEGRAM_BOT_TOKEN=
DATABASE_URL=
DATABASE_PATH=data/my-island.db
CORS_ORIGINS=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:3000

# Google integrations: OAuth is server-side; the refresh token is secret.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_CLASSROOM_COURSE_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_GRANTED_SCOPES=

# Production uses DATABASE_URL (Supabase Postgres connection string), never a browser key.
# SUPABASE_SERVICE_ROLE_KEY is intentionally not part of the runtime contract: the backend
# uses the Postgres connection string and the frontend must never receive privileged keys.
